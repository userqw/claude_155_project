<view class="page theme-{{theme}}">
  <view class="head">
    <view class="grow">
      <view class="head-title">{{title}}</view>
      <view class="section-sub">{{materials.length}} 张素材</view>
    </view>
    <view class="btn btn-ghost btn-sm" wx:if="{{folder && !locked}}" bindtap="onEditFolder">编辑</view>
  </view>

  <view class="grid">
    <view class="material" wx:for="{{materials}}" wx:key="id" data-id="{{item.id}}" bindtap="goMaterial">
      <image class="material-img" src="{{item.url}}" mode="aspectFill"></image>
      <view class="material-name">{{item.name}}</view>
      <view class="material-folder" wx:if="{{showFolder}}">{{item.folderName}}</view>
    </view>
  </view>

  <view class="btn btn-primary add-btn" wx:if="{{!locked}}" bindtap="onAddMaterial">+ 添加素材</view>

  <empty-state
    wx:if="{{locked || !materials.length}}"
    theme="{{theme}}"
    icon="{{locked ? '🔒' : '🖼'}}"
    title="{{locked ? '素材库是私有的' : '这里还没有素材'}}"
    sub="{{locked ? '登录后可以查看和整理你的素材' : '把参考图存进来，做的时候随手翻'}}"
  ></empty-state>
</view>
