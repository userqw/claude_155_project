.tag-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.tag-row:last-child {
  border-bottom: none;
}

.tag-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex: none;
}

.tag-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.tag-used {
  font-size: 22rpx;
  color: var(--text-3);
  margin-right: 20rpx;
}

.mini {
  font-size: 24rpx;
  color: var(--text-3);
  padding: 8rpx 12rpx;
}

.mini.danger {
  color: var(--danger);
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--mask);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--surface);
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-body {
  padding: 32rpx 32rpx 28rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 84rpx;
  background: var(--sunken);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--text);
  box-sizing: border-box;
}

.colors {
  display: flex;
  flex-wrap: wrap;
}

.color {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin: 0 20rpx 20rpx 0;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.color-active {
  border-color: var(--accent);
}

.footer {
  display: flex;
}

.footer .btn:first-child {
  margin-right: 20rpx;
}
