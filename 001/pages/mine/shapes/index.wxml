<view class="page theme-{{theme}}">
  <view class="card">
    <view class="row-between">
      <view class="section-title">品类</view>
      <text class="section-sub">内置的可改名不能删，自定义的可以随便增删</text>
    </view>

    <view class="shape" wx:for="{{shapes}}" wx:key="id">
      <view class="shape-left" data-id="{{item.id}}" bindtap="onEdit">
        <view class="shape-icon" style="background:{{item.color}}">
          <shape-icon
            theme="{{theme}}"
            path="{{item.iconPath}}"
            emoji="{{item.icon}}"
            size="md"
          ></shape-icon>
        </view>
        <view class="grow">
          <view class="shape-name">
            {{item.name}}
            <text class="builtin" wx:if="{{item.isBuiltin}}">内置</text>
          </view>
          <view class="shape-sub">
            已记录 {{item.used}} 个
          </view>
        </view>
      </view>

      <view class="shape-actions">
        <text class="mini" catchtap="onMoveUp" data-id="{{item.id}}">↑</text>
        <text class="mini" catchtap="onMoveDown" data-id="{{item.id}}">↓</text>
        <!-- 内置的四个品类不能删，连按钮都不给 -->
        <text class="mini danger" wx:if="{{!item.isBuiltin}}" catchtap="onDelete" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </view>

  <view class="btn btn-primary" wx:if="{{!locked}}" bindtap="onAdd">+ 新建品类</view>

  <empty-state
    wx:if="{{locked}}"
    theme="{{theme}}"
    icon="🔒"
    title="品类是私有的"
    sub="登录后能看到并管理你的品类"
  ></empty-state>
</view>

<!-- 编辑弹层 -->
<view wx:if="{{showEditor}}" class="mask" bindtap="onClose">
  <!-- catchtap 拦住点击往遮罩冒泡，但 catchtap 自己也会触发 handler：
       这里必须挂一个空函数，不能挂 onClose——否则在输入框里打字，
       点一下就把弹层关了。 -->
  <view class="sheet theme-{{theme}}" catchtap="onStop">
    <view class="sheet-body">
      <view class="field">
        <view class="field-label">名称</view>
        <input class="input" placeholder="例如：OB11娃头" value="{{form.name}}" bindinput="onName" />
      </view>

      <view class="field">
        <view class="field-label">图标</view>
        <view class="icons">
          <view
            class="icon {{form.icon === icon ? 'icon-active' : ''}}"
            wx:for="{{icons}}"
            wx:key="*this"
            wx:for-item="icon"
            data-icon="{{icon}}"
            bindtap="onIcon"
          >{{icon}}</view>
        </view>
      </view>

      <view class="field">
        <view class="field-label">颜色</view>
        <view class="colors">
          <view
            class="color {{form.slot === index ? 'color-active' : ''}}"
            wx:for="{{palette}}"
            wx:key="*this"
            wx:for-item="c"
            wx:for-index="index"
            style="background:{{c}}"
            data-slot="{{index}}"
            bindtap="onSlot"
          ></view>
        </view>
        <view class="field-sub">颜色跟随分类固定，筛选后不会换色</view>
      </view>

      <view class="footer">
        <view class="btn btn-ghost grow" bindtap="onClose">取消</view>
        <view class="btn btn-primary grow" bindtap="onSave">保存</view>
      </view>
    </view>
  </view>
</view>
