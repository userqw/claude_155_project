.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.head-total {
  font-size: 64rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.1;
}

.head-unit {
  font-size: 26rpx;
  color: var(--text-3);
  margin-left: 8rpx;
  font-weight: 400;
}

.year-pill {
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--surface);
  border-radius: 30rpx;
  padding: 12rpx 24rpx;
}

.legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  margin: 20rpx 0 28rpx;
}

.legend-text {
  font-size: 22rpx;
  color: var(--text-3);
  margin: 0 10rpx;
}

.legend-cell {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  margin-left: 4rpx;
}

.month {
  margin-bottom: 28rpx;
}

.month-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.month-title {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

.month-meta {
  font-size: 22rpx;
  color: var(--text-3);
}

.week-labels,
.week {
  display: flex;
}

.week-label {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-3);
  margin-bottom: 6rpx;
}

.cell {
  flex: 1;
  height: 60rpx;
  border-radius: 6rpx;
  margin: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cell-empty {
  background: transparent;
}

.cell-future {
  opacity: 0.35;
}

/* 颜色由 JS 按格子底色明度决定（白 / 近黑），这里只给字号 */
.cell-day {
  font-size: 20rpx;
}

.cell-fire {
  position: absolute;
  right: -4rpx;
  bottom: -6rpx;
  font-size: 16rpx;
  line-height: 1;
}

.cell {
  position: relative;
}

/* 选中的那天加一圈淡紫描边 */
.cell-selected {
  box-shadow: 0 0 0 4rpx var(--purple-20);
}

.day-list {
  margin-top: 8rpx;
}

.day-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.day-shape {
  font-size: 26rpx;
  color: var(--text-2);
  margin-left: 12rpx;
}

.day-count {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

.day-empty {
  font-size: 24rpx;
  color: var(--text-3);
  padding: 20rpx 0;
}

.link {
  font-size: 24rpx;
  color: var(--text-3);
}
