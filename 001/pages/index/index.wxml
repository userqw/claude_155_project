<view class="page page-tabbed theme-{{theme}}">
  <app-header
    theme="{{theme}}"
    title="捏土打卡"
    badge="手作"
    subtitle="今日记录"
    avatar="🎨"
  ></app-header>

  <!-- 登录引导：可关闭，不遮挡内容，浏览全程不强制登录 -->
  <view class="login-bar" wx:if="{{showLoginBar}}">
    <view class="grow">
      <view class="login-bar-title">✨ 登录后云端备份，换手机不丢记录</view>
      <view class="login-bar-sub">不登录也能完整记录</view>
    </view>
    <view class="btn btn-primary btn-sm" bindtap="goLogin">一键登录</view>
    <text class="login-bar-close" bindtap="onCloseLoginBar">✕</text>
  </view>

  <!-- 日期条 -->
  <view class="date-row">
    <view class="date-year">{{year}} 年</view>
    <view class="date-today">今日 {{todayText}} 🌸</view>
    <view class="date-status">
      <view class="date-dot"></view>
      <text>{{statusText}}</text>
    </view>
  </view>

  <!-- 打卡入口：点开才展示打卡表单 -->
  <view class="card checkin-card" bindtap="onTapCheckin">
    <view class="grow">
      <view class="checkin-title">🎀 {{hasToday ? '今天已经做了 ' + todayCount + ' 个' : '今天捏了吗？'}}</view>
      <view class="checkin-sub">{{hasToday ? '还可以再记一条，数量会自动累加' : '选个造型，拍张照，记下今天的手感'}}</view>
    </view>
    <view class="btn btn-primary btn-sm checkin-btn">{{hasToday ? '再记一条' : '去打卡'}}</view>
  </view>

  <!-- 今日已记录的明细 -->
  <view class="card card-tight" wx:if="{{todayRecords.length}}">
    <view class="today-row" wx:for="{{todayRows}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapEdit">
      <shape-icon
        theme="{{theme}}"
        path="{{item.shape.iconPath}}"
        emoji="{{item.shape.icon}}"
        size="sm"
      ></shape-icon>
      <text class="today-shape">{{item.shape.name}}</text>
      <text class="grow"></text>
      <text class="today-count">× {{item.count}}</text>
      <text class="today-edit">编辑</text>
    </view>
  </view>

  <!-- 概览 -->
  <view class="stat-row">
    <stat-tile
      theme="{{theme}}"
      icon="🏺"
      value="{{overview.production}}"
      unit="个"
      note="今年累计捏制"
      dot-tone="accent"
    ></stat-tile>
    <view class="stat-gap"></view>
    <stat-tile
      theme="{{theme}}"
      icon="💰"
      value="{{overview.revenue}}"
      unit="元"
      note="已售总额"
      dot-tone="good"
    ></stat-tile>
  </view>

  <!-- 本月节奏 -->
  <view class="card" wx:if="{{overview.production > 0}}" bindtap="goStats">
    <view class="row-between">
      <view class="section-title">近 6 个月手作节奏</view>
      <text class="link">年度统计 ›</text>
    </view>
    <chart-bar
      theme="{{theme}}"
      items="{{monthTrend}}"
      height="160"
      label-mode="extreme"
      unit="个"
    ></chart-bar>
  </view>

  <!-- 最近记录 -->
  <view class="card">
    <view class="row-between">
      <view class="section-title">🎨 最近手作记录</view>
      <text class="link" bindtap="goLibrary">全部 ›</text>
    </view>

    <empty-state
      wx:if="{{!recent.length}}"
      theme="{{theme}}"
      icon="🎨"
      title="还没有记录"
      sub="捏完第一个，就从这儿开始"
    ></empty-state>

    <view class="record" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <image wx:if="{{item.cover}}" class="record-cover" src="{{item.cover}}" mode="aspectFill"></image>
      <view wx:else class="record-cover record-cover-empty">
        <shape-icon
          theme="{{theme}}"
          path="{{item.shape.iconPath}}"
          emoji="{{item.shape.icon}}"
          size="lg"
        ></shape-icon>
      </view>
      <view class="grow">
        <view class="record-shape">{{item.shape.name}}</view>
        <view class="record-note" wx:if="{{item.note}}">{{item.note}}</view>
        <view class="record-foot">
          <text class="record-date">{{item.dateText}}</text>
          <text class="record-count">数量 {{item.count}} 个</text>
        </view>
      </view>

      <!-- 状态徽标与「售出」按钮同高（badge size=lg = 48rpx，按钮也是 48rpx） -->
      <view class="record-side">
        <badge
          theme="{{theme}}"
          tone="{{item.sold > 0 ? 'sold' : 'stock'}}"
          text="{{item.sold > 0 ? '售出' : '未售'}}"
          size="lg"
        ></badge>
        <view
          wx:if="{{item.unsold > 0}}"
          class="record-sell"
          catchtap="onTapSell"
          data-id="{{item.id}}"
        >售出</view>
      </view>
    </view>
  </view>
</view>


<sale-sheet
  visible="{{showSale}}"
  check-in="{{saleTarget}}"
  max-quantity="{{saleMax}}"
  theme="{{theme}}"
  bindclose="onSaleClose"
  bindsave="onSaleSave"
></sale-sheet>
