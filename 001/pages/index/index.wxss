.login-bar {
  display: flex;
  align-items: center;
  background: var(--pink-14);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.login-bar-title {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

.login-bar-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.login-bar-close {
  font-size: 30rpx;
  color: var(--text-3);
  padding: 12rpx 8rpx 12rpx 20rpx;
}

/* 日期条 */
.date-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.date-year {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  padding: 8rpx 4rpx;
}

.date-caret {
  font-size: 22rpx;
  color: var(--text-3);
}

.date-today {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-2);
  margin-left: 20rpx;
}

.date-status {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: 24rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: var(--text-2);
}

.date-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--good);
  margin-right: 10rpx;
}

/* 打卡入口卡：点开才弹出打卡表单 */
.checkin-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.checkin-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.5rpx;
}

.checkin-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 8rpx;
  line-height: 1.5;
}

.checkin-btn {
  flex: none;
  margin-left: 20rpx;
}

/* 今天已记录的明细 */
.today-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.today-shape {
  font-size: 26rpx;
  color: var(--text-2);
  margin-left: 12rpx;
}

.today-count {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-right: 20rpx;
}

.today-edit {
  font-size: 24rpx;
  color: var(--accent);
}

/* 概览 */
.stat-row {
  display: flex;
  margin-bottom: 24rpx;
}

.stat-gap {
  width: 20rpx;
}

.link {
  font-size: 24rpx;
  color: var(--text-3);
}

/* 最近记录 */
.record {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.record:last-child {
  border-bottom: none;
}

.record-cover {
  width: 116rpx;
  height: 116rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
  flex: none;
  background: var(--sunken);
}

.record-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.record-shape {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 8rpx;
}

.record-note {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.5;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-foot {
  display: flex;
  align-items: center;
}

.record-date {
  font-size: 22rpx;
  color: var(--text-3);
  margin-right: 20rpx;
}

.record-count {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 状态徽标靠右边缘对齐。每条记录只显示一个状态：
   卖完了「售出」，还剩着「未售」。 */
.record-side {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}
