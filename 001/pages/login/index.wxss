.page {
  min-height: 100vh;
  background: var(--page);
  padding: 80rpx 40rpx 48rpx;
  box-sizing: border-box;
}

.head {
  text-align: center;
  margin-bottom: 56rpx;
}

.logo-badge {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--accent-grad);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin: 0 auto 24rpx;
  box-shadow: 0 10rpx 28rpx var(--pink-28);
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.subtitle {
  font-size: 26rpx;
  color: var(--text-3);
}

.avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--sunken);
  border: 0;
  padding: 0;
  line-height: normal;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
}

.avatar-placeholder {
  font-size: 24rpx;
  color: var(--text-3);
}

.avatar-tip {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 16rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.field-hint {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
  margin-top: 12rpx;
}

.optional {
  font-size: 22rpx;
  color: var(--text-3);
  font-weight: 400;
  margin-left: 10rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background: var(--sunken);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
}

.warn {
  background: var(--sunken);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.backend-note {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
  margin: -12rpx 0 24rpx;
  word-break: break-all;
}

.login-btn {
  margin-top: 8rpx;
}

.skip {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 32rpx 0 24rpx;
}

.agreed {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-3);
  flex-wrap: wrap;
}

/* 圆圈勾选框 */
.check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid var(--purple-20);
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--on-inverse);
  box-sizing: border-box;
}

.check-on {
  background: var(--accent);
  border-color: var(--accent);
}

.agreed-text {
  margin: 0 4rpx;
}

.link {
  color: var(--text-2);
  margin: 0 4rpx;
}

.note {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.7;
  text-align: center;
}

.dev-entry {
  margin-top: 48rpx;
  text-align: center;
}

.dev-text {
  font-size: 22rpx;
  color: var(--text-3);
  text-decoration: underline;
}
