@import "../../styles/theme.wxss";

/* 四列网格：圆形色块图标 + 下方文字，与原型一致 */
.picker {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  width: 25%;
  min-width: 0;
  padding: 4rpx 8rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  border-radius: 24rpx;
  transition: transform 0.16s ease;
}

.chip-active {
  transform: translateY(-4rpx);
}

.chip-badge {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  border: 3rpx solid transparent;
  box-sizing: border-box;
  transition: box-shadow 0.18s ease;
}

.chip-active .chip-badge {
  border-color: var(--accent);
  box-shadow: 0 6rpx 16rpx var(--pink-26);
}

.chip-icon {
  font-size: 40rpx;
  line-height: 1;
}

.chip-name {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}

.chip-active .chip-name {
  color: var(--text);
  font-weight: 600;
}
