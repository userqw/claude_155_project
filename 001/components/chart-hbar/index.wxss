@import "../../styles/theme.wxss";

.hbar {
  width: 100%;
}

.hbar-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.hbar-label {
  width: 168rpx;
  flex: none;
  display: flex;
  align-items: center;
}

.swatch {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex: none;
  margin-right: 10rpx;
}

.hbar-name {
  font-size: 24rpx;
  color: var(--text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hbar-track {
  flex: 1;
  min-width: 0;
  height: 24rpx;
  display: flex;
  align-items: center;
}

.hbar-bar {
  height: 24rpx;
  /* 数据端 4px 圆角，基线端保持方角 */
  border-radius: 0 8rpx 8rpx 0;
  min-width: 4rpx;
  transition: width 0.24s ease;
}

.hbar-value {
  width: 132rpx;
  flex: none;
  text-align: right;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
}

.hbar-count {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.hbar-pct {
  font-size: 22rpx;
  color: var(--text-3);
  margin-left: 8rpx;
}

.hbar-empty {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}

/* -- 原型两行式布局：上行名称与数值分列两侧，下行一条通栏进度条 -- */

.hbar-stack {
  padding: 16rpx 0;
}

.hbar-stack-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.hbar-stack-label {
  display: flex;
  align-items: center;
  min-width: 0;
  padding-right: 16rpx;
}

.hbar-stack-name {
  font-size: 26rpx;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hbar-stack-value {
  flex: none;
  display: flex;
  align-items: baseline;
}

.hbar-stack-count {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.hbar-stack-pct {
  font-size: 22rpx;
  color: var(--text-3);
  margin-left: 10rpx;
}

.hbar-stack-track {
  height: 16rpx;
  border-radius: 8rpx;
  background: var(--sunken);
  overflow: hidden;
}

.hbar-stack-bar {
  height: 16rpx;
  /* 数据端 4px 圆角，基线端保持方角 */
  border-radius: 0 8rpx 8rpx 0;
  min-width: 4rpx;
  transition: width 0.24s ease;
}
