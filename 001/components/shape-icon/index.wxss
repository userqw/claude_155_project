@import "../../styles/theme.wxss";

.shape-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  line-height: 1;
}

.shape-icon-img {
  width: 100%;
  height: 100%;
}

.shape-icon-text {
  line-height: 1;
}

/* 尺寸档位 */
.shape-icon-sm {
  width: 28rpx;
  height: 28rpx;
  font-size: 24rpx;
}

.shape-icon-md {
  width: 40rpx;
  height: 40rpx;
  font-size: 34rpx;
}

.shape-icon-lg {
  width: 56rpx;
  height: 56rpx;
  font-size: 46rpx;
}
