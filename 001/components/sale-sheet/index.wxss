@import "../../styles/theme.wxss";
@import "../../styles/common.wxss";

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--mask);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  /* 固定高度而不是只给 max-height：
     高度不确定时 scroll-view 会把内容撑开，底部的提交按钮会被挤出可视区 */
  height: 80vh;
  overflow: hidden;
  background: var(--surface);
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
}

.handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--baseline);
  margin: 16rpx auto 0;
  flex: none;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 12rpx;
  flex: none;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.sheet-close {
  font-size: 32rpx;
  color: var(--text-3);
  padding: 8rpx 12rpx;
}

/* flex:1 + height:0 让 scroll-view 拿到确定高度，从而真正可滚动 */
.body {
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  padding: 8rpx 32rpx 24rpx;
}

.target {
  background: var(--sunken);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
}

.target-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-right: 12rpx;
}

.target-name {
  font-size: 26rpx;
  color: var(--text);
  flex: 1;
}

.target-stock {
  font-size: 24rpx;
  color: var(--text-2);
}

.field {
  margin-bottom: 32rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.optional {
  font-size: 22rpx;
  color: var(--text-3);
  font-weight: 400;
  margin-left: 10rpx;
}

.counter {
  display: flex;
  align-items: center;
}

.counter-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--sunken);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--text);
}

.counter-btn.disabled {
  opacity: 0.35;
}

.counter-input {
  flex: 1;
  text-align: center;
  font-size: 52rpx;
  font-weight: 600;
  color: var(--text);
  height: 76rpx;
  line-height: 76rpx;
}

.input {
  width: 100%;
  height: 84rpx;
  background: var(--sunken);
  border-radius: 24rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--text);
  box-sizing: border-box;
}

.total {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
}

.picker-value {
  font-size: 28rpx;
  color: var(--text);
  background: var(--sunken);
  border-radius: 24rpx;
  padding: 18rpx 20rpx;
}

.arrow {
  color: var(--text-3);
  margin-left: 8rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: var(--sunken);
  color: var(--text-2);
  font-size: 24rpx;
  margin: 0 16rpx 16rpx 0;
}

.tag-active {
  background: var(--accent-grad);
  color: var(--on-accent);
}

/* 提交区：固定贴在弹层底部，不参与滚动，永远可见 */
.footer {
  flex: none;
  display: flex;
  padding: 20rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  background: var(--surface);
}
