@import "../../styles/theme.wxss";
@import "../../styles/common.wxss";

.app-header {
  display: flex;
  align-items: center;
  padding: 8rpx 4rpx 24rpx;
}

.app-header-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--accent-grad);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
  flex: none;
  box-shadow: 0 6rpx 16rpx var(--pink-28);
}

.app-header-title {
  display: flex;
  align-items: center;
}

.app-header-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.5rpx;
}

.app-header-badge {
  margin-left: 12rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 14rpx;
  border-radius: 17rpx;
  background: var(--accent-grad);
  color: var(--on-accent);
  font-size: 20rpx;
  font-weight: 600;
}

.app-header-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}
